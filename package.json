{
  "name": "pearclaw",
  "version": "0.1.0",
  "description": "AI pair programmer — gives your OpenClaw agent real-time oversight of Claude Code or Codex CLI",
  "type": "module",
  "bin": {
    "pearclaw": "./src/server.js"
  },
  "exports": {
    ".": "./src/server.js",
    "./gateway-bridge": "./src/gateway-bridge.js",
    "./config": "./src/config.js",
    "./context-injector": "./src/context-injector.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "node test/integration.js"
  },
  "keywords": [
