  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sideEyeLabs/pearclaw"
  },
  "homepage": "https://github.com/sideEyeLabs/pearclaw",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ws": "^8.18.0"
  }
}
